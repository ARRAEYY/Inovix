# ─── Backend ───────────────────────────────────────────────────────────────
# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (dev = SQLite file; prod = PostgreSQL connection string)
# To use Postgres instead, set DATABASE_URL="postgresql://user:pass@localhost:5432/campus_food?schema=public"
# and update apps/backend/prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Auth — generate strong random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (student + staff sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# College email domain gate. A leading dot allows subdomains:
#   .rishihood.edu.in  → matches rishihood.edu.in AND *.rishihood.edu.in
#   rishihood.edu.in   → matches rishihood.edu.in only (no subdomains)
COLLEGE_EMAIL_DOMAIN=.rishihood.edu.in

# ─── Dev login (M1 — local dev convenience, INO-007) ───────────────────────
# EXPLICITLY opt-in. The /api/v1/auth/dev-login endpoint is mounted ONLY when
# NODE_ENV=development AND ENABLE_DEV_LOGIN=true. Never set this to true in
# staging, preview, or production — the endpoint bypasses Google OAuth.
# Default value here is `true` so the local dev workflow (npm run dev:backend)
# keeps working out of the box.
ENABLE_DEV_LOGIN=true


# ─── Encryption (M2 — Payment credentials) ─────────────────────────────────
# 32-byte (256-bit) key, base64-encoded. Generate with: openssl rand -base64 32
OUTLET_CREDENTIALS_KEY=replace-with-32-byte-base64-key

# ─── Razorpay (M2 — Per-outlet accounts) ───────────────────────────────────
# Used for the platform's own account (if any). Each outlet stores its own
# credentials (encrypted) via the super-admin endpoints.
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
# Sandbox base URLs (do not change unless you know what you're doing)
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ─── Cloudinary (M2 — Image uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Socket.IO (M3 — Realtime) ────────────────────────────────────────────
# Same origin as backend; long-polling fallback is automatic.
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# ─── Audit log retention (days) ───────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=90

# ─── Pickup no-show window (minutes) ───────────────────────────────────────
# Per spec §8.6: a READY order auto-moves to COMPLETED-with-no-refund after
# this many minutes if the student doesn't pick up.
PICKUP_TIMEOUT_MINS=30

# ─── Cron jobs ──────────────────────────────────────────────────────────────
# Set to "false" to disable all cron jobs (audit purge, refresh purge,
# pickup timeout). Defaults to true in non-test environments.
RUN_CRON=true

# ─── Reconciliation + Outbox worker (INO-AUDIT5) ─────────────────────────────
# Three background workers that together form a complete financial reliability
# loop for refunds + payments:
#
# 1. Refund outbox worker (every OUTBOX_INTERVAL_MINS):
#    Processes PENDING refunds with gatewayRef=NULL — these are refunds that
#    were created in the order-transition tx but never sent to the gateway
#    (server crashed between tx commit and post-commit call). The worker
#    calls processRefundAfterCommit to send the refund to Razorpay.
#
# 2. Refund reconciliation worker (every RECONCILIATION_INTERVAL_MINS):
#    Polls Razorpay for the STATUS of PENDING refunds that HAVE a gatewayRef
#    (the gateway call succeeded, but the webhook was missed or the refund is
#    still processing at the gateway).
#
# 3. Payment reconciliation worker (same interval):
#    Polls Razorpay for stale PENDING payments (missed payment.captured/failed
#    webhooks). Marks PAID if the gateway says captured; FAILED if the gateway
#    says failed or too many attempts.
#
# All actions are audited (REFUND_OUTBOX_PROCESSED, REFUND_RECONCILED,
# PAYMENT_RECONCILED_PAID/FAILED).

# Outbox worker (processes NEW orphans — more frequent)
OUTBOX_INTERVAL_MINS=2
OUTBOX_MIN_AGE_MINS=2

# Reconciliation workers (polls for STATUS — less frequent)
RECONCILIATION_INTERVAL_MINS=10
RECONCILIATION_MIN_AGE_MINS=5
PAYMENT_RECONCILIATION_MIN_AGE_MINS=30

# ─── Payment max attempts (for reconciliation) ──────────────────────────────
# If a PENDING payment's gateway order has had this many failed attempts,
# the reconciliation worker marks the payment FAILED (student can retry
# with a fresh order). Default 5.
PAYMENT_MAX_ATTEMPTS=5
